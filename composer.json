{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "A fullstack Laravel API and Vue local-first, fully offline PWA for program, boat, trip, and booking management.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "clickbar/laravel-magellan": "^2.3",
        "firebase/php-jwt": "^7.2.1",
        "laravel/framework": "^13.38",
        "laravel/octane": "^2.22",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.31",
        "laravel/telescope": "^5.26",
        "laravel/wayfinder": "^0.1.23",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "lorisleiva/laravel-actions": "^2.13",
        "resend/resend-php": "^1.17",
        "sentry/sentry-laravel": "^4.29",
        "spatie/icalendar-generator": "^3.3.1",
        "spatie/laravel-data": "^4.23",
        "spatie/typescript-transformer": "^3.3.1",
        "timokoerber/laravel-one-time-operations": "^1.4.6"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.13.2",
        "laravel/boost": "^2.10.3",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.69",
        "laravel/tinker": "^3.0.2",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^13.4.3",
        "serversideup/spin": "^3.5.2",
        "spatie/laravel-stubs": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "deploy:storage-config": [
            "@php artisan storage:configure --no-interaction"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pint",
            "vendor/bin/phpstan analyse --memory-limit=512M",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan spatie-stub:publish --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
